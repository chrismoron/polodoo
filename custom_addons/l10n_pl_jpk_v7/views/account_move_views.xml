<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Add JPK_V7 tag to the invoice PL Extra tab -->
    <record id="view_move_form_jpk_tag_inherit" model="ir.ui.view">
        <field name="name">account.move.form.jpk_tag</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="l10n_pl_edi_fixes.view_move_form_l10n_pl_edi_fixes"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='l10n_pl_compliance']/group" position="inside">
                <group string="JPK_V7 Ewidencja">
                    <field name="l10n_pl_jpk_tag"/>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
