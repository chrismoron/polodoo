# Copy to .env for local development ONLY.
# For Coolify production: set these in the Coolify UI → Environment Variables tab.
# NEVER commit a .env file with real secrets to git.

# ── PostgreSQL ─────────────────────────────────────────────────────────────────
POSTGRES_USER=odoo
POSTGRES_PASSWORD=<generate: openssl rand -base64 32>

# ── Odoo master password ──────────────────────────────────────────────────────
# Injected into odoo.conf by scripts/odoo-entrypoint.sh at container start.
# Gates /web/database/manager — even though list_db=False also blocks it,
# defense-in-depth. Generate with: openssl rand -base64 32
ODOO_MASTER_PASSWORD=<generate: openssl rand -base64 32>

# ── Company domains ────────────────────────────────────────────────────────────
# Each subdomain routes to its own database via dbfilter = ^%d_db$
# mnl.yourdomain.com → mnl_db
# bioleaf.yourdomain.com → bioleaf_db
ODOO_DOMAIN_MNL=mnl.yourdomain.com
ODOO_DOMAIN_BIOLEAF=bioleaf.yourdomain.com

# ── Traefik certificate resolver ───────────────────────────────────────────────
# Coolify's default is "letsencrypt". Override only for staging/test envs.
TRAEFIK_CERTRESOLVER=letsencrypt

# ── Off-host backup (optional but RECOMMENDED) ─────────────────────────────────
# Cloudflare R2, AWS S3, or any S3-compatible storage. If unset, backups stay
# on the host disk only (single point of failure).
BACKUP_S3_BUCKET=odoo-backups
BACKUP_S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
BACKUP_S3_REGION=auto
BACKUP_S3_KEY=<your-access-key>
BACKUP_S3_SECRET=<your-secret-key>
